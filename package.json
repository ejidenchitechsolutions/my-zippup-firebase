{
  "name": "zippup-platform",
  "version": "1.0.0",
  "description": "ZippUp - Multi-Service On-Demand Platform",
  "main": "web/build/index.html",
  "scripts": {
    "build": "npm run build:web",
    "build:web": "cd web && npm install && npm run build",
    "build:admin": "cd admin && npm install && npm run build",
    "build:functions": "cd functions && npm install && npm run build",
    "build:all": "npm run build:functions && npm run build:web && npm run build:admin",
    "start": "node server.js",
    "start:web": "cd web && npm start",
    "start:admin": "cd admin && npm run dev",
    "dev": "concurrently \"npm run start:web\" \"npm run start:admin\"",
    "install:all": "npm install && cd functions && npm install && cd ../web && npm install && cd ../admin && npm install",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "postbuild": "echo \"Build completed successfully\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejidenchitechsolutions/my-zippup-firebase.git"
  },
  "keywords": [
    "firebase",
    "react",
    "vue",
    "flutter",
    "on-demand",
    "platform",
    "multi-service",
    "emergency",
    "payments",
    "maps"
  ],
  "author": "EjidenchiTech Solutions",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ejidenchitechsolutions/my-zippup-firebase/issues"
  },
  "homepage": "https://github.com/ejidenchitechsolutions/my-zippup-firebase#readme",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}