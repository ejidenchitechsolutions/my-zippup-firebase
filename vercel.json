{
  "version": 2,
  "name": "zippup-platform",
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/web/build/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/web/build/index.html"
    }
  ],
  "functions": {
    "web/build/**": {
      "includeFiles": "web/build/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/web/build/index.html"
    }
  ],
  "headers": [
    {
      "source": "/web/build/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}